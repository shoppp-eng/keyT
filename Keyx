    }, tabBar)

    local page = new("ScrollingFrame", {
        Name = "Page_" .. tabTitle, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(12, 12, 14), BackgroundTransparency = 0, BorderSizePixel = 0,
        ScrollBarThickness = 4, ScrollBarImageColor3 = C.redDim, CanvasSize = UDim2.new(),
