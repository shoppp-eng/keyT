    saveQueued = true
    task.delay(0.5, function()
        saveQueued = false
        pcall(function()
            if makefolder and isfolder and not isfolder(SAVE_FOLDER) then makefolder(SAVE_FOLDER) end
            writefile(SAVE_PATH, HttpService:JSONEncode({
                ToggleKey = UI.ToggleKey.Name,
                UserScale = userScale,
                PosX = posX, PosY = posY,
            }))
        end)
    end)
end

