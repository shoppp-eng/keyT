-- ── 13c. TEXT INPUT FIX ───────────────────────────────────────────────────────
-- RaycityEscGate keeps an invisible "trap" TextBox focused to swallow Esc and
-- re-captures focus whenever another box gains it, so our Input boxes could not
-- be typed in. Switch the trap off while the menu is open, back on when folded.
do
    local okGate, EscGate = pcall(function() return require(ReplicatedStorage.RaycityUi.RaycityEscGate) end)
    if okGate and type(EscGate) == "table" and EscGate.setTrapEnabled then
        local trapOff = false
        task.spawn(function()
            while alive() do
                local want = UI.Visible == true
                if want ~= trapOff or want then
                    pcall(EscGate.setTrapEnabled, not want)
                    trapOff = want
                end
                task.wait(0.3)
            end
        end)
        onCleanup(function() pcall(EscGate.setTrapEnabled, true) end)
    end
end

