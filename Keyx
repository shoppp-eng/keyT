        PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 22), PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 18),
    }, page)

    local tab = { button = button, page = page, x = nextTabX, w = w }
    nextTabX += w + 14
