            g.npcId, g.level = f.npcId, f.level or 0
            g.name = f.nativeName or f.nameFallback or tostring(f.npcId)
            g.pos = Vector3.new(f.pos[1], f.pos[2], f.pos[3])
            return g
        end
    end
    return nil
