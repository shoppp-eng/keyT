-- ── 6d. INVENTORY → STORAGE ──────────────────────────────────────────────────
-- A full bag makes "Get All" fail and the drop is lost. The storage box can be
-- used from anywhere (TownServices "storage" open → deposit, no fee); duplicates
-- go first, starting from the newest cell. Some items refuse to move
-- (stCanNotMoveItem) and are remembered so they are not retried.
local Store = { badIds = {} }
local function storeApi()
    if Store.T == nil then
        local ok, m = pcall(function()
            return require(ReplicatedStorage:WaitForChild("RaycityTown", 5):WaitForChild("TownServices", 5))
        end)
        Store.T = (ok and type(m) == "table" and m.request) and m or false
    end
    return Store.T or nil
end
local function profileNow()
    local ok, PC = pcall(require, ReplicatedStorage.RaycityProfile.ProfileClient)
    if not ok then return nil end
    local ok2, prof = pcall(PC.get)
    return ok2 and type(prof) == "table" and prof or nil
end

local function storeStep(force)
    local T, prof = storeApi(), profileNow()
    if not (T and prof and type(prof.inventory) == "table") then return end
    local used, cells, idCount = 0, {}, {}
    for cell, it in pairs(prof.inventory) do
        used += 1
        local c = tonumber(cell)
        if c and type(it) == "table" and it.id then
            cells[#cells + 1] = { cell = c, id = it.id }
            idCount[it.id] = (idCount[it.id] or 0) + 1
        end
    end
    local size = tonumber(prof.invSize) or 30
    if not force and size - used > 2 then
        Status.Store = string.format("กระเป๋า %d/%d", used, size)
        return
    end
    local open = T.request("storage", "open", { index = 1 })
    if not (type(open) == "table" and open.ok) then
        Status.Store = "เปิดโกดังไม่ได้"
        return
    end
    -- duplicates first, newest cell first
    table.sort(cells, function(a, b)
        local da, db = idCount[a.id] > 1, idCount[b.id] > 1
        if da ~= db then return da end
        return a.cell > b.cell
    end)
    local moved = 0
    for _, c in ipairs(cells) do
        if size - (used - moved) >= 8 then break end
        if not Store.badIds[c.id] then
            local r = T.request("storage", "deposit", { index = 1, from = c.cell })
            if type(r) == "table" and r.ok then
                moved += 1
                idCount[c.id] -= 1
            elseif type(r) == "table" and r.msgKey == "stCanNotMoveItem" then
                Store.badIds[c.id] = true
            else
                Status.Store = "โกดังเต็มหรือฝากไม่ได้: " .. tostring(type(r) == "table" and (r.msgKey or r.err) or "?")
                break
            end
            task.wait(0.3)
        end
    end
    Status.StoredTotal = (Status.StoredTotal or 0) + moved
    if moved > 0 then
        Status.Store = string.format("ฝากเข้าโกดังแล้ว %d ชิ้น (รวม %d)", moved, Status.StoredTotal)
    end
end

-- ── 6e. AUTO SELL ─────────────────────────────────────────────────────────────
-- ShopRequest "sell" works from anywhere (no shop visit). Only duplicates are
-- sold (SellKeep of each id stays), never gems/materials (type 2), items with
-- rolled options (opt), bound/expiring items or anything the game prices at 0.
local SellApi = {}
local function sellPriceOf(it)
    if SellApi.items == nil then
        local ok, m = pcall(require, ReplicatedStorage.RaycityShop.ShopItems)
        SellApi.items = ok and m or false
        local ok2, p = pcall(require, ReplicatedStorage.RaycityShop.ItemSellPrice)
        SellApi.price = ok2 and type(p) == "table" and p.ofDef and p or false
    end
    local d = SellApi.items and SellApi.items[it.id]
    if not d then return 0, nil end
    local sell = (d.serverPrice and d.serverPrice[2]) or d.sell or 0
    if SellApi.price then
        local ok, v = pcall(SellApi.price.ofDef, d, it.id)
        if ok and type(v) == "number" then sell = v end
    end
    -- same rules as the game's sell dialog
    if it.bound or it.expires ~= nil then return 0, d end
    if d.type and d.type >= 5 and d.type <= 8 then return 0, d end
    if d.bonding and d.bonding ~= 0 then return 0, d end
    return tonumber(sell) or 0, d
end

local function sellStep()
    local prof = profileNow()
    if not (prof and type(prof.inventory) == "table") then return end
    local SR = ReplicatedStorage.RaycityShop.Remotes:FindFirstChild("ShopRequest")
    if not SR then return end
    local keep = math.max(0, tonumber(Config.SellKeep) or 1)
    local byId = {}
    for cell, it in pairs(prof.inventory) do
        local c = tonumber(cell)
        if c and type(it) == "table" and it.id and it.uid then
            local list = byId[it.id] or {}
            byId[it.id] = list
            list[#list + 1] = { cell = c, it = it }
        end
    end
    local earned, sold = 0, 0
    for _, list in pairs(byId) do
        local total = 0
        for _, e in ipairs(list) do total += (tonumber(e.it.count) or 1) end
        local extra = total - keep
        if extra > 0 then
            local price, def = sellPriceOf(list[1].it)
            if price > 0 and def and def.type ~= 2 then
                -- sell from the newest cells, plain (no rolled options) items only
                table.sort(list, function(a, b) return a.cell > b.cell end)
                for _, e in ipairs(list) do
                    if extra <= 0 then break end
                    if e.it.opt == nil then
                        local n = math.min(extra, tonumber(e.it.count) or 1)
                        local ok, r = pcall(SR.InvokeServer, SR, "sell", { cell = e.cell, count = n, uid = e.it.uid })
                        if ok and type(r) == "table" and r.ok then
                            extra -= n
                            sold += n
                            earned += tonumber(r.paid or r.total) or 0
                        end
                        task.wait(0.4)
                    end
                end
            end
        end
    end
    if sold > 0 then
        Status.SoldTotal = (Status.SoldTotal or 0) + sold
        Status.SoldMoney = (Status.SoldMoney or 0) + earned
        Status.Store = string.format("ขายของซ้ำ %d ชิ้น +%d เงิน (รวม +%d)", sold, earned, Status.SoldMoney)
    end
end

-- Sell every item the game will buy, in one go (manual button).
local function sellAll()
    local prof = profileNow()
    if not (prof and type(prof.inventory) == "table") then return 0, 0 end
    local SR = ReplicatedStorage.RaycityShop.Remotes:FindFirstChild("ShopRequest")
    if not SR then return 0, 0 end
    local list = {}
    for cell, it in pairs(prof.inventory) do
        local c = tonumber(cell)
        if c and type(it) == "table" and it.uid then list[#list + 1] = { cell = c, it = it } end
    end
    table.sort(list, function(a, b) return a.cell > b.cell end)
    local sold, earned = 0, 0
    for _, e in ipairs(list) do
        if sellPriceOf(e.it) > 0 then
            local n = tonumber(e.it.count) or 1
            local ok, r = pcall(SR.InvokeServer, SR, "sell", { cell = e.cell, count = n, uid = e.it.uid })
            if ok and type(r) == "table" and r.ok then
                sold += n
                earned += tonumber(r.paid or r.total) or 0
            end
            task.wait(0.35)
        end
    end
    Status.SoldTotal = (Status.SoldTotal or 0) + sold
    Status.SoldMoney = (Status.SoldMoney or 0) + earned
    if sold > 0 then
        Status.Store = string.format("ขายแล้ว %d ชิ้น +%d เงิน (รวม +%d)", sold, earned, Status.SoldMoney)
    end
    return sold, earned
end

