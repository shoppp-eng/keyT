-- ── 6f. MONEY TRANSFER (in-game mail) ────────────────────────────────────────
-- Raynet mail carries Rain to any player by their in-game name, across
-- servers, with no accept step: SocialClient.request("mail.send", {to, subject,
-- content, money, auto}) → {ok, receipt = {money, fee, ...}}. The game charges
-- a flat 200 Rain fee per letter on top. The receiver collects attachments
-- with "mail.take" {id}; AutoTakeMail does that for every mail in the box.
local Mail = { log = {}, taken = {} }
local function socialApi()
    if Mail.SC == nil then
        local ok, m = pcall(function() return require(ReplicatedStorage.RaycitySocial.SocialClient) end)
        Mail.SC = (ok and type(m) == "table" and m.request) and m or false
    end
    return Mail.SC or nil
end

local function mailLog(msg)
    Status.Trade = msg
    table.insert(Mail.log, 1, os.date("%H:%M:%S ") .. msg)
    if #Mail.log > 6 then table.remove(Mail.log) end
end

-- Returns ok, message.
local function sendMoney(targetName, amount)
    local SC = socialApi()
    if not SC then return false, "หาระบบจดหมายไม่เจอ" end
    targetName = tostring(targetName or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if targetName == "" then return false, "ใส่ชื่อผู้รับก่อน" end
    amount = math.floor(tonumber(amount) or 0)
    if amount <= 0 then return false, "จำนวนเงินไม่ถูกต้อง" end
    local have = tonumber(LocalPlayer:GetAttribute("RaycityRain")) or 0
    if amount > have then return false, string.format("เงินไม่พอ (มี %d)", have) end

    local ok, r = pcall(SC.request, "mail.send", {
        to = targetName,
        subject = "2K SCRIPT",
        content = string.format("ส่ง Rain %d", amount),
        money = amount,
        auto = { subject = true, content = true },
    })
    if ok and type(r) == "table" and r.ok then
        local rc = type(r.receipt) == "table" and r.receipt or {}
        Status.SentTotal = (Status.SentTotal or 0) + amount
        Status.SentFee = (Status.SentFee or 0) + (tonumber(rc.fee) or 0)
        local msg = string.format("ส่ง %d ให้ %s แล้ว (ค่าส่ง %s)", amount, tostring(rc.to or targetName), tostring(rc.fee or "?"))
        mailLog(msg)
        return true, msg
    end
    local why = "?"
    if ok and type(r) == "table" then
        local okT, txt = pcall(SC.text, r)
        why = (okT and txt and txt ~= "") and txt or tostring(r.key or r.err or r.msg or "?")
    elseif not ok then
        why = tostring(r)
    end
    local msg = "ส่งไม่สำเร็จ: " .. why
    mailLog(msg)
    return false, msg
end

-- receiver side: collect money/items from every mail in the box
local function takeMailStep()
    local SC = socialApi()
    local box = SC and SC.box
    if not (box and type(box.mails) == "table") then return end
    for _, m in ipairs(box.mails) do
        if type(m) == "table" and m.id and not Mail.taken[m.id] then
            Mail.taken[m.id] = true
            local ok, r = pcall(SC.request, "mail.take", { id = m.id })
            if ok and type(r) == "table" and r.ok then
                Status.MailTaken = (Status.MailTaken or 0) + 1
                mailLog("รับจดหมายจาก " .. tostring(m.from or "?") .. (m.money and (" +" .. tostring(m.money)) or ""))
            end
            task.wait(0.5)
        end
    end
end

