function UI:Toggle(state)
    if state == nil then state = not UI.Visible end
    if state == UI.Visible then return end
    UI.Visible = state
    if state then
        window.Visible = true
        local goal = targetScale()
        windowScale.Scale = goal * 0.94
        TweenService:Create(windowScale, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = goal }):Play()
    else
        window.Visible = false
    end
end

