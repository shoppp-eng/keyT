-- mission givers seen so far (NPCs only exist while streamed in)
local knownGivers = {}
local function scanGivers()
    local folder = workspace:FindFirstChild("RBRCNpcs")
    if not folder then return end
    for _, m in ipairs(folder:GetChildren()) do
        local id = m:GetAttribute("RBRCNpcId")
        -- mission:* taxi rides, mission24:* side jobs, thtalk:* deliveries
        if type(id) == "string" and (id:match("^mission:") or id:match("^mission24:") or id:match("^thtalk:")) then
            local ok, pivot = pcall(m.GetPivot, m)
            if ok then
                knownGivers[id] = knownGivers[id] or {}
                knownGivers[id].pos = pivot.Position
                knownGivers[id].mark = m:GetAttribute("MarkType")
            end
        end
    end
end

-- Best giver = most money per metre of driving. Unknown givers are tried
-- with an optimistic guess so every NPC gets talked to once; after a run
-- the giver rests briefly so the loop rotates through the reward pools.
local function nearestGiver()
    scanGivers()
    local root = getPart("Root")
    if not root then return nil end
    local bestId, best, bestScore
    local now = os.clock()
    for id, g in pairs(knownGivers) do
        if (g.blockedUntil or 0) < now then
            local d = flat(g.pos, root.Position)
            local money = g.money or 500
            local score = money / (d + 600)
            -- a resting giver is only used when nothing else is available
            if (g.restUntil or 0) > now then score -= 10 end
            if not bestScore or score > bestScore then bestId, best, bestScore = id, g, score end
        end
    end
    return bestId, best
end

