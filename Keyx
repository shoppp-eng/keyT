-- Stops once the car exists in the city.
local function enterPress(btn)
    if getconnections then
        local n = 0
        for _, sig in ipairs({ "Activated", "MouseButton1Click" }) do
            local ok, list = pcall(getconnections, btn[sig])
            if ok and type(list) == "table" then
                for _, c in ipairs(list) do
                    if c.Function then pcall(c.Function); n += 1 end
                end
            end
            if n > 0 then return true end
        end
    end
    if firesignal and pcall(firesignal, btn.Activated) then return true end
    return pcall(function()
        local VIM = game:GetService("VirtualInputManager")
        local inset = game:GetService("GuiService"):GetGuiInset()
        local p = btn.AbsolutePosition + btn.AbsoluteSize / 2 + inset
        VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0)
        task.wait(0.05)
        VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0)
    end)
end

local function shownOnScreen(g)
    if not (g and g.Parent) then return false end
    local p = g
    while p and not p:IsA("LayerCollector") do
        if p:IsA("GuiObject") and not p.Visible then return false end
        p = p.Parent
    end
    return p == nil or (p:IsA("ScreenGui") and p.Enabled)
end

-- Channel select GUI: rows are RaycityEntryChannel.*.ChannelN (Text "Ch.N",
-- Count "a/b", Ms "x ms") with Connect in the same panel. A fresh join
-- is not on a numbered channel, so Connect teleports to the chosen one: pick
-- the least crowded channel that is not full (then lowest ping).
local function channelChoice()
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local rowsGui = pg and pg:FindFirstChild("RaycityEntryChannel")
    local btnGui = pg and pg:FindFirstChild("RaycityChannel")
    if not (rowsGui and rowsGui.Enabled) then return nil end
    -- the shown (modern) panel has its own Connect; RaycityChannel's is hidden
    local connectBtn = rowsGui:FindFirstChild("Connect", true)
    if not (connectBtn and connectBtn:IsA("GuiButton")) and btnGui then
        connectBtn = btnGui:FindFirstChild("Connect", true)
    end
    if not (connectBtn and connectBtn:IsA("GuiButton")) then return nil end
    local best, bestKey
    for _, row in ipairs(rowsGui:GetDescendants()) do
        if row:IsA("GuiButton") and row.Name:match("^Channel%d+$") then
            local cnt = row:FindFirstChild("Count", true)
            local ms = row:FindFirstChild("Ms", true)
            local a, b = tostring(cnt and cnt.Text or ""):match("(%d+)%s*/%s*(%d+)")
            a, b = tonumber(a), tonumber(b)
            local ping = tonumber(tostring(ms and ms.Text or ""):match("(%d+)")) or 999
            if a and b and a < b then
                local key = a * 1000 + ping
                if not bestKey or key < bestKey then best, bestKey = row, key end
            end
        end
    end
    return connectBtn, best
end

