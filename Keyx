-- ── drag helper (window header) ───────────────────────────────────────────────
local function makeDrag(handle, threshold, onBegin, onDelta, onFinish)
    local active, moved, startPos = false, false, Vector3.zero
    give(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            active, moved, startPos = true, false, input.Position
            onBegin()
        end
    end))
    give(UserInputService.InputChanged:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - startPos
            if not moved and Vector2.new(d.X, d.Y).Magnitude > threshold then moved = true end
            if moved then onDelta(Vector2.new(d.X, d.Y)) end
        end
    end))
    give(UserInputService.InputEnded:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            active = false
            onFinish(moved)
        end
    end))
end

do
    local sx, sy = 0, 0
    makeDrag(dragZone, 4, function() sx, sy = posX, posY end, function(d)
        local s = windowScale.Scale
        local vp = viewport()
        posX = math.clamp(sx + d.X / s, -vp.X / (2 * s) + 90, vp.X / (2 * s) - 90)
        posY = math.clamp(sy + d.Y / s, -vp.Y / (2 * s) + 4, vp.Y / (2 * s) - 40)
        window.Position = UDim2.new(0.5, posX, 0.5, posY)
    end, function(moved)
        if moved then saveSettings() end
    end)
end

