local function chooseRfMission(missions)
    local best, bestKey
    for _, m in ipairs(missions or {}) do
        if m.canAccept and m.playable ~= false and m.questId then
            -- unplayed first, then fully supported routes, then higher slot
            local key = (m.cleared and 0 or 100) + ((m.reasons and #m.reasons > 0) and 0 or 10) + (m.slot or 0)
            if not bestKey or key > bestKey then best, bestKey = m, key end
        end
    end
    return best
end

local function runRoadFight(g, keepGoing)
    Status.Mission = "ขับไปหา Road Fight " .. g.name
    -- talk range is 8 m (16 studs); the NPC body blocks getting much closer
    local arrived = driveNear(g.pos, 8, nil, keepGoing)
    if arrived ~= true then
        if arrived == "stuck" then g.blockedUntil = os.clock() + 60 end
        return
    end
    if not keepGoing() then return end
    setIn(0, 1, 0)
    task.wait(0.8)

    local root = getPart("Root")
    if not root then return end
    local talk = rfInvoke({ op = "talk", npcId = g.npcId, carPos = root.Position })
    if not (talk and talk.ok) then
        releaseRfHold()
        clearIn()
        Status.Mission = "คุย Road Fight ไม่สำเร็จ: " .. tostring(talk and (talk.reason or talk.reasonKey) or "?")
        g.blockedUntil = os.clock() + 120
        return
    end
    local m = chooseRfMission(talk.missions)
    if not m then
        releaseRfHold()
        clearIn()
        Status.Mission = g.name .. ": ไม่มีรอบที่รับได้"
        g.blockedUntil = os.clock() + 1800
        return
    end

    missionResult, missionLast = nil, {}
    local accept = rfInvoke({ op = "accept", questId = m.questId, carPos = root.Position })
    clearIn()
    if not (accept and accept.ok) then
        releaseRfHold()
        Status.Mission = "รับ Road Fight ไม่ได้: " .. tostring(accept and (accept.reason or accept.reasonKey) or "?")
        g.blockedUntil = os.clock() + 300
        return
    end
    -- the quest client confirms boarding by itself; then free the car
    task.wait(1.5)
    releaseRfHold()

    local stockCruise = Config.CruiseKmh
    if AutoDrive.C and stockMaxSpeed then
        AutoDrive.C.maxSpeed = math.max(stockMaxSpeed, math.max(stockCruise, 160) / 3.6)
    end
    local before = Status.MissionsDone
    followMission(tostring(m.title or m.questId), keepGoing)
    applyCruise()
    if Status.MissionsDone == before then g.blockedUntil = os.clock() + 120 end
end

local function runMission(keepGoing)
    -- a mission already running (reload, or started by hand): finish it first
    local movFolder = workspace:FindFirstChild("RBRCMissionCars")
    local chaseLive = movFolder and movFolder:FindFirstChild("MovCar") and os.clock() - (Status.UpdateAt or 0) < 3
    if missionGuideDest() or chaseLive then
        missionResult = nil
        followMission("ภารกิจที่ค้างอยู่", keepGoing)
        return
    end

    -- a mission picked in the dropdown: always go to that one NPC
    Config.MissionPick = MISSION_CHOICES[1].label -- locked: always auto (loop every mission)
    local choice = MISSION_BY_LABEL[Config.MissionPick]
    if choice and choice.rf then
        local g = rfGiverById(choice.rf)
        -- a picked NPC has no alternative, so never sit out the long backoff
        if g and (g.blockedUntil or 0) > os.clock() + 10 then g.blockedUntil = os.clock() + 10 end
        if not g then
            Status.Mission = "หา Road Fight นี้ไม่เจอ"
            task.wait(3)
        elseif (g.blockedUntil or 0) > os.clock() then
            Status.Mission = string.format("%s: รอ NPC พร้อม ลองใหม่ใน %d วิ", g.name, g.blockedUntil - os.clock())
            task.wait(1)
        else
            runRoadFight(g, keepGoing)
        end
        return
    end

    local id, giver
    if choice and choice.npc then
        id = choice.npc
        scanGivers()
        giver = knownGivers[id] or {}
        knownGivers[id] = giver
        giver.pos = giver.pos or staticNpcPos(id)
        giver.restUntil = nil
        if (giver.blockedUntil or 0) > os.clock() + 10 then giver.blockedUntil = os.clock() + 10 end
        if not giver.pos then
            Status.Mission = "หาตำแหน่ง NPC " .. id .. " ไม่เจอ"
            task.wait(3)
            return
        end
        if (giver.blockedUntil or 0) > os.clock() then
            Status.Mission = string.format("%s: รอ NPC พร้อม ลองใหม่ใน %d วิ", choice.label, giver.blockedUntil - os.clock())
            task.wait(1)
            return
        end
    else
        -- auto mode: regular givers only; Road Fight is picked from the dropdown
        id, giver = nearestGiver()
    end
    if not id then
        Status.Mission = "ไม่เจอ NPC ภารกิจ (ลองขับไปแถวที่มี NPC)"
        task.wait(3)
        return
    end

    Status.Mission = "ขับไปหา NPC " .. id
    local arrived = driveNear(giver.pos, 5, nil, keepGoing)
    if arrived ~= true then
        if arrived == "stuck" then giver.blockedUntil = os.clock() + 30 end
        return
    end
    if not keepGoing() then return end
    task.wait(0.4)

    local root = getPart("Root")
    if not root then return end
    local talk = questInvoke({ op = "talk", npcId = id, carPos = root.Position })
    if not (talk and talk.ok and talk.offers) then
        Status.Mission = "คุยกับ NPC ไม่สำเร็จ: " .. tostring(talk and (talk.reason or talk.why) or "?")
        giver.blockedUntil = os.clock() + 60
        closeOfferWindow()
        task.wait(1)
        return
    end

    local offer
    for _, o in ipairs(talk.offers) do
        if o.playable ~= false and o.questId then offer = o break end
    end
    if not offer then
        Status.Mission = "NPC นี้ไม่มีภารกิจที่รับได้"
        giver.blockedUntil = os.clock() + 600
        closeOfferWindow()
        questInvoke({ op = "talkEnd", npcId = id })
        return
    end
    local preview = offer.rewardPreview and offer.rewardPreview[1]
    if preview and preview.money then giver.money = preview.money end

    missionResult, missionLast = nil, {}
    local accept = questInvoke({ op = "accept", questId = offer.questId, carPos = root.Position, carLook = root.CFrame.LookVector })
    if not (accept and accept.ok) then
        Status.Mission = "รับภารกิจไม่ได้: " .. tostring(accept and (accept.reason or accept.reasonKey) or "?")
        giver.blockedUntil = os.clock() + 120
        closeOfferWindow()
        return
    end
    -- rotate: rest this giver so the next run tries another reward pool
    giver.restUntil = os.clock() + 240
    if accept.needsBoarding then
        Status.Mission = "รอผู้โดยสารขึ้นรถ"
        task.wait(2.5)
        questInvoke({ op = "boarded", questId = offer.questId })
    end

    followMission(tostring(offer.title or offer.questId), keepGoing)
end

-- Drives the active mission's guide until the server sends its result.
followMission = function(title, keepGoing)
    local curVer, chaseAt, lastSlideAt
    local t0 = os.clock()
    while alive() and keepGoing() and not missionResult and os.clock() - t0 < 600 do
        local dest, ver = missionGuideDest()
        local hull = getPart("Hull")
        local rootPart = getPart("Root")
        if rootPart and rootPart.Anchored then releaseRfHold() end
        -- chase missions (MovChase: "catch the thief") have no guide point;
        -- the target is the moving car in workspace.RBRCMissionCars
        local movFolder = workspace:FindFirstChild("RBRCMissionCars")
        local movCar = (not dest) and movFolder and movFolder:FindFirstChild("MovCar")
        if movCar and os.clock() - (Status.UpdateAt or 0) > 8 then
            break -- leftover thief car from a finished mission
        end
        if movCar and hull then
            local okP, tp = pcall(function() return movCar:GetPivot().Position end)
            if okP then
                local d = flat(tp, hull.Position)
                if AutoDrive.C and stockMaxSpeed then
                    AutoDrive.C.maxSpeed = math.max(stockMaxSpeed, 200 / 3.6)
                end
                if d > 70 then
                    if not chaseAt or flat(tp, chaseAt) > 40 or not adActive() then
                        chaseAt = tp
                        adGo(tp)
                    end
                else
                    -- close: aim ahead of the thief using its measured speed and ram it
                    adStop()
                    chaseAt = nil
                    local prevP, prevT = tp, os.clock()
                    local tRam = os.clock()
                    while os.clock() - tRam < 4 and movCar.Parent and not missionResult and alive() and keepGoing() do
                        local okQ, q = pcall(function() return movCar:GetPivot().Position end)
                        if not okQ then break end
                        local now = os.clock()
                        local vel = (now > prevT) and (q - prevP) / (now - prevT) or Vector3.zero
                        prevP, prevT = q, now
                        local deg, dd = headingError(hull, q + vel * math.clamp(flat(q, hull.Position) / 60, 0, 0.8))
                        if dd > 120 then break end
                        setIn(1, 0, math.clamp(deg / 18, -1, 1))
                        -- the attack is the side-slide (Z/X): fire it toward the
                        -- thief while it is beside us inside the 14 m prompt range
                        local rel = (q - hull.Position) * Vector3.new(1, 0, 1)
                        local side = rel:Dot(hull.CFrame.RightVector)
                        if rel.Magnitude < 24 and math.abs(side) > 2 and now - (lastSlideAt or 0) > 1.6 then
                            lastSlideAt = now
                            local ph = gshared().RCDrive and gshared().RCDrive.phys
                            if ph and PhysicsMod and PhysicsMod.sideSlide then
                                pcall(PhysicsMod.sideSlide, ph, side < 0)
                            end
                        end
                        task.wait(0.03)
                    end
                    clearIn()
                end
                Status.Mission = string.format("%s • ไล่จับ ห่าง %d • ความพอใจ %s • เหลือ %s วิ", title, d,
                    Status.Gauge and string.format("%.0f", Status.Gauge) or "-",
                    Status.Remaining and string.format("%.0f", Status.Remaining / 1000) or "-")
            end
            task.wait(0.3)
            continue
        end
        if dest and hull and flat(dest, hull.Position) < 45 then
            -- AutoDrive parks short of the zone and re-plans in circles;
            -- steer through the last stretch directly until the guide moves on
            adStop()
            local startVer = ver
            local function movedOn()
                local _, v = missionGuideDest()
                return missionResult ~= nil or v ~= startVer
            end
            -- slow, speed-matched finish so "stop" zones are entered under control
            local t1 = os.clock()
            while os.clock() - t1 < 10 and alive() and keepGoing() and not movedOn() do
                local p = missionGuideDest()
                if not p then break end
                local deg, dist = headingError(hull, p)
                if dist <= 3 then break end
                local fwd = hull.AssemblyLinearVelocity:Dot(hull.CFrame.LookVector)
                local want = math.clamp(dist * 0.9, 8, 55)
                if math.abs(deg) > 40 then want = math.min(want, 18) end
                local thr, brk = 0, 0
                if fwd < want - 3 then
                    thr = math.abs(deg) > 70 and 0.35 or 0.7
                elseif fwd > want + 5 then
                    brk = math.clamp((fwd - want) / 25, 0.2, 0.8)
                else
                    thr = 0.2
                end
                setIn(thr, brk, math.clamp(deg / 20, -1, 1))
                task.wait(0.03)
            end
            if not movedOn() then
                -- "stop" destinations only count once the car stands still in
                -- the zone: brake and hold until the game moves the guide on
                local t2 = os.clock()
                while os.clock() - t2 < 4 and alive() and keepGoing() and not movedOn() do
                    setIn(0, 1, 0)
                    -- brake while stopped would reverse; release once stationary
                    if hull.AssemblyLinearVelocity.Magnitude < 1 then setIn(0, 0, 0) end
                    task.wait(0.05)
                end
            end
            clearIn()
            curVer = nil
        elseif dest and (ver ~= curVer or not adActive()) then
            curVer = ver
            adGo(dest)
        end
        Status.Mission = string.format("%s • ความพอใจ %s • เหลือ %s วิ", title,
            Status.Gauge and string.format("%.0f", Status.Gauge) or "-",
            Status.Remaining and string.format("%.0f", Status.Remaining / 1000) or "-")
        task.wait(0.5)
    end
    adStop()
    clearIn()
    applyCruise()

    if missionResult then
        if missionResult.success ~= false and missionResult.reasonKey ~= "stMissionError" then
            Status.MissionsDone += 1
            local items = type(missionResult.items) == "table" and #missionResult.items or 0
            Status.Items = (Status.Items or 0) + items
            Status.Mission = string.format("สำเร็จ %s +%s เงิน +%d ไอเทม", title, tostring(missionResult.money or 0), items)
        else
            Status.MissionsFailed += 1
            Status.Mission = "ภารกิจไม่ผ่าน เริ่มใหม่"
        end
        task.wait(3)
    elseif not keepGoing() then
        questInvoke({ op = "abandon" })
    end
end

