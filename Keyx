-- every widget bound to a Config key, so a loaded profile can refresh the UI
local Widgets = {}
local function bindToggle(section, key, name, desc, onChange)
    local api
    api = section:Toggle({
        Name = name,
        Desc = desc,
        Default = Config[key],
        Callback = function(v)
            Config[key] = v
            saveConfig()
            if onChange then onChange(v) end
        end,
    })
    Widgets[key] = api
    return api
end

