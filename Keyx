-- fixed NPC placements: QuestData.npcRows = {id, _, _, model, tex, anim, x, y, z, ...}
local npcPosCache
local function staticNpcPos(id)
    if not npcPosCache then
        npcPosCache = {}
        pcall(function()
            local QD = require(ReplicatedStorage.RBRCQuest:WaitForChild("QuestData"))
            for _, r in pairs(QD.npcRows) do
                if type(r) == "table" and type(r[1]) == "string" and tonumber(r[7]) then
                    npcPosCache[r[1]] = Vector3.new(r[7], r[8], r[9])
                end
            end
        end)
    end
