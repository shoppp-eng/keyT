local MISSION_CHOICES = {
    { label = "อัตโนมัติ (วนทุกภารกิจ)" },
    { label = "Road Fight: Derix (Lv4)", rf = 1676 },
    { label = "Road Fight: Do young (Lv7)", rf = 1681 },
