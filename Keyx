local notifSeq = 0
function UI:Notify(options)
    options = options or {}
    local title = tostring(options.Title or "")
    local text = tostring(options.Text or "")
    local duration = tonumber(options.Duration) or 3
    local textH = text ~= "" and measure(text, 12, Enum.Font.Gotham, 252).Y or 0
    local h = 14 + 18 + (textH > 0 and (4 + textH) or 0) + 14
    notifSeq += 1

    local card = new("CanvasGroup", {
        Size = UDim2.fromOffset(290, h), BackgroundColor3 = Color3.fromRGB(16, 16, 20), BorderSizePixel = 0,
        GroupTransparency = 1, LayoutOrder = notifSeq, ZIndex = 20,
    }, notifHolder)
    corner(card, 10)
    stroke(card, Color3.fromRGB(70, 26, 30), 1)
    local bar = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 3, 0.7, 0),
        BackgroundColor3 = C.red, BorderSizePixel = 0,
    }, card)
    corner(bar, 2)
    new("TextLabel", {
        Position = UDim2.fromOffset(18, 12), Size = UDim2.fromOffset(256, 18), BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd, Text = title, TextColor3 = C.text,
    }, card)
    if text ~= "" then
        new("TextLabel", {
            Position = UDim2.fromOffset(18, 34), Size = UDim2.fromOffset(256, textH), BackgroundTransparency = 1,
            Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, Text = text, TextColor3 = C.sub,
        }, card)
    end

    -- keep at most 5 toasts
    local toasts = {}
    for _, ch in ipairs(notifHolder:GetChildren()) do
        if ch:IsA("CanvasGroup") then toasts[#toasts + 1] = ch end
    end
    table.sort(toasts, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    while #toasts > 5 do
        table.remove(toasts, 1):Destroy()
    end

    TweenService:Create(card, TweenInfo.new(0.2), { GroupTransparency = 0 }):Play()
    task.delay(duration, function()
        if not card.Parent then return end
        local t = TweenService:Create(card, TweenInfo.new(0.25), { GroupTransparency = 1 })
        t.Completed:Connect(function() card:Destroy() end)
        t:Play()
    end)
end

