    if #tabs == 1 then selectTab(tab) end

    local order = 0
    local function nextOrder()
        order += 1
        return order
    end

    local TabApi = {}

    function TabApi:Section(sectionTitle)
        sectionTitle = tostring(sectionTitle)

        -- header: red diamond + bold caps + hairline
        local head = new("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, page)
        new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 7, 0.5, 2), Size = UDim2.fromOffset(9, 9),
            Rotation = 45, BackgroundColor3 = C.red, BorderSizePixel = 0,
        }, head)
        local tw = measure(sectionTitle, 12, Enum.Font.GothamBold, 500).X
        new("TextLabel", {
            Position = UDim2.fromOffset(22, 2), Size = UDim2.fromOffset(tw + 6, 28), BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left,
            Text = sectionTitle, TextColor3 = C.text,
        }, head)
        new("Frame", {
            Position = UDim2.new(0, 22 + tw + 16, 0.5, 2), Size = UDim2.new(1, -(22 + tw + 16), 0, 1),
            BackgroundColor3 = C.line, BorderSizePixel = 0,
        }, head)

        local SecApi = {}

        local function makeRow(height)
            local row = new("Frame", {
                Size = UDim2.new(1, 0, 0, height), BackgroundColor3 = C.card, BorderSizePixel = 0, LayoutOrder = nextOrder(),
            }, page)
            corner(row, 10)
            stroke(row, C.cardStroke, 1)
            local bar = new("Frame", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(0, 3, 0.66, 0),
                BackgroundColor3 = C.red, BorderSizePixel = 0,
            }, row)
            corner(bar, 2)
            return row
        end

        -- row with title (+ wrapped description), right side reserved for a control
        local function makeTextRow(name, desc, reserve)
            local textW = ROW_W - 18 - reserve
            local hasDesc = desc ~= nil and desc ~= ""
            local descH = hasDesc and math.max(15, measure(desc, 12, Enum.Font.Gotham, textW).Y) or 0
            local height = hasDesc and (13 + 19 + 3 + descH + 13) or 48
            local row = makeRow(math.max(height, 48))
            local title = new("TextLabel", {
                Position = UDim2.fromOffset(18, hasDesc and 13 or 0),
                Size = hasDesc and UDim2.fromOffset(textW, 19) or UDim2.new(0, textW, 1, 0),
                BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 14,
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                Text = tostring(name or ""), TextColor3 = C.text,
            }, row)
            local descLabel
            if hasDesc then
                descLabel = new("TextLabel", {
                    Position = UDim2.fromOffset(18, 35), Size = UDim2.fromOffset(textW, descH), BackgroundTransparency = 1,
                    Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top, Text = tostring(desc), TextColor3 = C.sub,
                }, row)
            end
            return row, title, descLabel
        end

        local function hoverable(row, target)
            target = target or row
            give(target.MouseEnter:Connect(function() row.BackgroundColor3 = C.cardHover end))
            give(target.MouseLeave:Connect(function() row.BackgroundColor3 = C.card end))
        end

        -- Toggle -----------------------------------------------------------------
        function SecApi:Toggle(opts)
            opts = opts or {}
            local state = (opts.Default == true)
            local row = makeTextRow(opts.Name, opts.Desc, 104)

            local pill = new("Frame", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -16, 0.5, 0), Size = UDim2.fromOffset(70, 32),
                BackgroundColor3 = C.off, BorderSizePixel = 0,
            }, row)
            corner(pill, 8)
            local label = new("TextLabel", {
                Size = UDim2.fromOffset(34, 32), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13,
                Text = "OFF", TextColor3 = Color3.fromRGB(128, 128, 136),
            }, pill)
            local knob = new("Frame", {
                AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(26, 26), Position = UDim2.new(0, 3, 0.5, 0),
                BackgroundColor3 = Color3.fromRGB(96, 96, 104), BorderSizePixel = 0,
            }, pill)
            corner(knob, 6)

            local info = TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local function visual(animate)
                local pillGoal = { BackgroundColor3 = state and C.red or C.off }
                local knobGoal = {
                    Position = UDim2.new(0, state and 41 or 3, 0.5, 0),
                    BackgroundColor3 = state and Color3.fromRGB(248, 248, 250) or Color3.fromRGB(96, 96, 104),
                }
                label.Text = state and "ON" or "OFF"
                label.TextColor3 = state and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(128, 128, 136)
                label.Position = UDim2.fromOffset(state and 4 or 32, 0)
                if animate then
                    TweenService:Create(pill, info, pillGoal):Play()
                    TweenService:Create(knob, info, knobGoal):Play()
                else
                    for k, v in pairs(pillGoal) do pill[k] = v end
                    for k, v in pairs(knobGoal) do knob[k] = v end
                end
            end
            visual(false)

            local api = {}
            function api:Set(val, suppressCallback)
                val = (val == true)
                if state == val then return end
                state = val
                visual(true)
                if not suppressCallback then safeSpawn(opts.Callback, state) end
            end
            function api:Get() return state end

            local click = new("TextButton", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2,
            }, row)
            hoverable(row, click)
            give(click.MouseButton1Click:Connect(function() api:Set(not state) end))
            return api
        end

        -- Slider -----------------------------------------------------------------
        function SecApi:Slider(opts)
            opts = opts or {}
            local minV, maxV = tonumber(opts.Min) or 0, tonumber(opts.Max) or 100
            local step = tonumber(opts.Step) or 1
            local suffix = opts.Suffix or ""
            local cur = math.clamp(tonumber(opts.Default) or minV, minV, maxV)
            local range = (maxV > minV) and (maxV - minV) or 1

            local row = makeRow(64)
            new("TextLabel", {
                Position = UDim2.fromOffset(18, 11), Size = UDim2.new(1, -170, 0, 19), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opts.Name or ""), TextColor3 = C.text,
            }, row)
            local valLabel = new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 11), Size = UDim2.fromOffset(150, 19),
                BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Right,
                Text = tostring(cur) .. suffix, TextColor3 = C.red,
            }, row)

            local track = new("Frame", {
                Position = UDim2.new(0, 18, 0, 43), Size = UDim2.new(1, -36, 0, 6), BackgroundColor3 = Color3.fromRGB(38, 38, 44),
                BorderSizePixel = 0,
            }, row)
            corner(track, 3)
            local fill = new("Frame", { Size = UDim2.fromScale((cur - minV) / range, 1), BackgroundColor3 = C.red, BorderSizePixel = 0 }, track)
            corner(fill, 3)
            local thumb = new("Frame", {
                AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new((cur - minV) / range, 0, 0.5, 0), Size = UDim2.fromOffset(16, 16),
                BackgroundColor3 = Color3.fromRGB(248, 248, 250), BorderSizePixel = 0, ZIndex = 2,
            }, track)
            corner(thumb, 8)
            stroke(thumb, C.red, 2)

            local lastFired = cur
            local function visual()
                local p = (cur - minV) / range
                fill.Size = UDim2.fromScale(p, 1)
                thumb.Position = UDim2.new(p, 0, 0.5, 0)
                valLabel.Text = tostring(cur) .. suffix
            end

            local api = {}
            function api:Set(val, suppressCallback)
                val = math.clamp(tonumber(val) or cur, minV, maxV)
                cur = val
                visual()
                if not suppressCallback and cur ~= lastFired then
                    lastFired = cur
                    safeSpawn(opts.Callback, cur)
                elseif suppressCallback then
                    lastFired = cur
                end
            end
            function api:Get() return cur end

            local hit = new("Frame", {
                AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 26),
                BackgroundTransparency = 1, Active = true, ZIndex = 3,
            }, track)
            local dragging = false
            local function fromX(x)
                local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                local v = math.floor((minV + rel * range - minV) / step + 0.5) * step + minV
                cur = math.clamp(v, minV, maxV)
                visual()
            end
            give(hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    fromX(input.Position.X)
                end
            end))
            give(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    fromX(input.Position.X)
                end
            end))
            give(UserInputService.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    dragging = false
                    if cur ~= lastFired then
                        lastFired = cur
                        safeSpawn(opts.Callback, cur)
                    end
                end
            end))
            return api
        end

        -- Button -----------------------------------------------------------------
        function SecApi:Button(opts)
            opts = opts or {}
            local row = makeTextRow(opts.Name, opts.Desc, 60)
            new("TextLabel", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.5, -1), Size = UDim2.fromOffset(24, 28),
                BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 24, Text = "›", TextColor3 = C.red,
            }, row)
            local click = new("TextButton", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2,
            }, row)
            hoverable(row, click)
            give(click.MouseButton1Click:Connect(function()
                row.BackgroundColor3 = Color3.fromRGB(44, 20, 23)
                TweenService:Create(row, TweenInfo.new(0.25), { BackgroundColor3 = C.card }):Play()
                safeSpawn(opts.Callback)
            end))
        end

        -- Dropdown (opts.Locked = shows the value only: no arrow, cannot open) ----
        function SecApi:Dropdown(opts)
            opts = opts or {}
            local locked = opts.Locked == true
            local options = {}
            for _, o in ipairs(opts.Options or {}) do options[#options + 1] = tostring(o) end
            local selected = opts.Default ~= nil and tostring(opts.Default) or options[1]

            local row = makeRow(48)
            row.ClipsDescendants = true
            new("TextLabel", {
                Position = UDim2.fromOffset(18, 0), Size = UDim2.new(0, 250, 0, 48), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opts.Name or ""), TextColor3 = C.text,
            }, row)

            local box = new("Frame", {
                AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 9), Size = UDim2.fromOffset(300, 30),
                BackgroundColor3 = C.field, BorderSizePixel = 0,
            }, row)
            corner(box, 7)
            local boxStroke = stroke(box, C.chipStroke, 1)
            local selLabel = new("TextLabel", {
                Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, locked and -20 or -36, 1, 0), BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = selected or "-", TextColor3 = C.text,
            }, box)
            local arrow
            if not locked then
                arrow = new("TextLabel", {
                    AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(16, 16),
                    BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13, Text = "▾", TextColor3 = C.red,
                }, box)
            end

            local api = {}
            if locked then
                function api:Set() end -- locked: a loaded profile cannot change it
                function api:Get() return selected end
                function api:SetOptions() end
                return api
            end

            local isOpen = false
            local list = new("ScrollingFrame", {
                Position = UDim2.fromOffset(14, 54), Size = UDim2.new(1, -28, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
                ScrollBarThickness = 3, ScrollBarImageColor3 = C.redDim, CanvasSize = UDim2.new(),
                AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
            }, row)
            new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, list)

            local function listHeight() return math.min(#options, 6) * 32 end
            local function layout()
                if isOpen then
                    list.Visible = true
                    list.Size = UDim2.new(1, -28, 0, listHeight())
                    row.Size = UDim2.new(1, 0, 0, 54 + listHeight() + 10)
                else
                    list.Visible = false
                    row.Size = UDim2.new(1, 0, 0, 48)
                end
                if arrow then arrow.Text = isOpen and "▴" or "▾" end
                boxStroke.Color = isOpen and C.red or C.chipStroke
            end

            local function rebuild()
                for _, ch in ipairs(list:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for i, name in ipairs(options) do
                    local b = new("TextButton", {
                        Size = UDim2.new(1, -6, 0, 30), BackgroundColor3 = (name == selected) and Color3.fromRGB(40, 18, 21) or C.field,
                        BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.GothamMedium, TextSize = 13,
                        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "  " .. name,
                        TextColor3 = (name == selected) and C.red or C.text, LayoutOrder = i,
                    }, list)
                    corner(b, 6)
                    give(b.MouseButton1Click:Connect(function()
                        api:Set(name)
                        isOpen = false
                        layout()
                    end))
                end
                layout()
            end

            function api:Set(val, suppressCallback)
                selected = tostring(val)
                selLabel.Text = selected
                rebuild()
                if not suppressCallback then safeSpawn(opts.Callback, selected) end
            end
            function api:Get() return selected end
            function api:SetOptions(newOpts)
                options = {}
                for _, o in ipairs(newOpts or {}) do options[#options + 1] = tostring(o) end
                if not table.find(options, selected) then
                    selected = options[1]
                    selLabel.Text = selected or "-"
                end
                rebuild()
            end

            local click = new("TextButton", {
                Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 48), BackgroundTransparency = 1, Text = "",
                AutoButtonColor = false, ZIndex = 2,
            }, row)
            give(click.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                layout()
            end))
            rebuild()
            return api
        end

        -- Keybind ----------------------------------------------------------------
        function SecApi:Keybind(opts)
            opts = opts or {}
            local key = opts.Default or Enum.KeyCode.RightControl
            local listening = false
            local row = makeRow(48)
            new("TextLabel", {
                Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -200, 1, 0), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opts.Name or ""), TextColor3 = C.text,
            }, row)
            local btn = new("TextButton", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(150, 30),
                BackgroundColor3 = C.field, BorderSizePixel = 0, AutoButtonColor = false, Font = Enum.Font.GothamBold,
                TextSize = 13, Text = key.Name, TextColor3 = C.red,
            }, row)
            corner(btn, 7)
            stroke(btn, C.chipStroke, 1)

            local api = {}
            function api:Set(newKey)
                key = newKey
                btn.Text = key.Name
            end
            function api:Get() return key end

            give(btn.MouseButton1Click:Connect(function()
                listening = true
                UI._listening = true
                btn.Text = "..."
            end))
            give(UserInputService.InputBegan:Connect(function(input)
                if not listening or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                listening = false
                task.defer(function() UI._listening = false end)
                if input.KeyCode == Enum.KeyCode.Escape then
                    btn.Text = key.Name
                    return
                end
                key = input.KeyCode
                btn.Text = key.Name
                if opts.Changed then safeSpawn(opts.Changed, key) end
            end))
            return api
        end

        -- Input ------------------------------------------------------------------
        function SecApi:Input(opts)
            opts = opts or {}
            local row = makeRow(48)
            new("TextLabel", {
                Position = UDim2.fromOffset(18, 0), Size = UDim2.new(0.38, 0, 1, 0), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opts.Name or ""), TextColor3 = C.text,
            }, row)
            local box = new("TextBox", {
                AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.new(0.56, 0, 0, 30),
                BackgroundColor3 = C.field, BorderSizePixel = 0, ClearTextOnFocus = false, Font = Enum.Font.GothamMedium,
                TextSize = 13, Text = tostring(opts.Default or ""), PlaceholderText = opts.Placeholder or "",
                PlaceholderColor3 = Color3.fromRGB(110, 110, 118), TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, row)
            corner(box, 7)
            local bs = stroke(box, C.chipStroke, 1)
            new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, box)
            give(box.Focused:Connect(function() bs.Color = C.red end))
            give(box.FocusLost:Connect(function()
                bs.Color = C.chipStroke
                safeSpawn(opts.Callback, box.Text)
            end))
            return {
                Set = function(_, text) box.Text = tostring(text or "") end,
                Get = function() return box.Text end,
            }
        end

        -- Paragraph (live title + description) ------------------------------------
        function SecApi:Paragraph(opts)
            opts = opts or {}
            local row = makeRow(66)
            local title = new("TextLabel", {
                Position = UDim2.fromOffset(18, 10), Size = UDim2.new(1, -36, 0, 19), BackgroundTransparency = 1,
                Font = Enum.Font.GothamBold, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd, Text = tostring(opts.Name or ""), TextColor3 = C.text,
            }, row)
            local desc = new("TextLabel", {
                Position = UDim2.fromOffset(18, 31), Size = UDim2.new(1, -36, 0, 28), BackgroundTransparency = 1,
                Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.AtEnd,
                Text = (opts.Desc and opts.Desc ~= "") and tostring(opts.Desc) or "-", TextColor3 = C.sub,
            }, row)
            return {
                TitleLabel = title,
                SetTitle = function(text) title.Text = tostring(text) end,
                SetDesc = function(text) desc.Text = tostring(text) end,
            }
        end

        -- Label ------------------------------------------------------------------
        function SecApi:Label(textString)
            local row = makeRow(40)
            new("TextLabel", {
                Position = UDim2.fromOffset(18, 0), Size = UDim2.new(1, -36, 1, 0), BackgroundTransparency = 1,
                Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
                Text = tostring(textString or ""), TextColor3 = C.sub,
            }, row)
        end

        return SecApi
    end

    return TabApi
end

