-- Precise pickup approach. The game only eats a spot when the Hull passes
-- within ~1 stud, so speed is matched to the remaining distance, and a spot
-- that ends up close behind the car is reversed onto instead of circling.
local function pickupApproach(e, keepGoing)
    local hull = getPart("Hull")
    if not hull then return false end
    local d0 = flat(e.base, hull.Position)
    local t0 = os.clock()
    local maxT = 4 + d0 / 10
    local slowSince, unstucks = nil, 0
    local reversing = false
    while os.clock() - t0 < maxT and alive() and (not keepGoing or keepGoing()) do
        if e.eatT or e.dead or not hull.Parent then break end
        local deg, dist = headingError(hull, e.base)
        local vel = hull.AssemblyLinearVelocity
        local speed = vel.Magnitude
        local fwd = vel:Dot(hull.CFrame.LookVector)

        -- reverse onto spots that are close and behind; hysteresis avoids dithering
        if dist < 30 and math.abs(deg) > 115 then
            reversing = true
        elseif math.abs(deg) < 65 or dist > 40 then
            reversing = false
        end

        if speed < 2 and os.clock() - t0 > 1.2 then
            slowSince = slowSince or os.clock()
            if os.clock() - slowSince > 1.5 then
                unstucks += 1
                if unstucks > 2 then
                    setIn(0, 1, 0)
                    task.wait(0.3)
                    clearIn()
                    return "stuck"
                end
                -- wall in the way: back off with the wheel turned the other way
                setIn(0, 1, -math.clamp(deg / 25, -1, 1))
                task.wait(0.9)
                slowSince = nil
            end
        else
            slowSince = nil
        end

        if reversing then
            local back = (deg + 360) % 360 - 180 -- error measured from the tail
            if fwd > 6 then
                setIn(0, 1, 0) -- stop first, then the brake pedal reverses
            else
                setIn(0, 0.8, math.clamp(-back / 20, -1, 1))
            end
        else
            -- target speed falls with distance so the last metres are precise
            local want = math.clamp(dist * 1.1, 14, 70)
            if math.abs(deg) > 40 then want = math.min(want, 22) end
            local thr, brk = 0, 0
            if fwd < want - 3 then
                thr = math.abs(deg) > 70 and 0.35 or 0.75
            elseif fwd > want + 6 then
                brk = math.clamp((fwd - want) / 25, 0.2, 0.8)
            else
                thr = 0.25
            end
            setIn(thr, brk, math.clamp(deg / 20, -1, 1))
        end
        task.wait(0.03)
    end
    clearIn()
    return (e.eatT ~= nil) or (e.dead == true)
end

local triedCoin = {}
local function coinStep(keepGoing)
    local hull = getPart("Hull")
    if not (spots and hull) then
        Status.Coin = "รอรถ..."
        task.wait(1)
        return
    end
    -- cheapest next pickup: distance plus a penalty for turning around
    local best, bestScore, bd
    for uid, e in pairs(spots) do
        if wantType(e.type) and not e.eatT and not e.dead and (triedCoin[uid] or 0) < os.clock() then
            local deg, d = headingError(hull, e.base)
            if d <= Config.CoinRange then
                local score = d + math.abs(deg) * 1.2
                if e.type ~= 0 then score -= 80 end -- SP and boxes are worth the detour
                if not bestScore or score < bestScore then best, bestScore, bd = e, score, d end
            end
        end
    end
    if not best then
        Status.Coin = "ไม่มีของให้เก็บใกล้ๆ รอเกิดใหม่"
        clearIn()
        task.wait(2)
        return
    end
    triedCoin[best.uid] = os.clock() + 20
    Status.Coin = string.format("ไปเก็บ%s (ห่าง %d)", TYPE_NAME[best.type] or "ของ", bd)
    local function gone() return best.eatT ~= nil or best.dead == true end
    local res
    local hullNow = getPart("Hull")
    if hullNow and flat(best.base, hullNow.Position) > 70 then
        -- long legs on the road network, stopping short so the finish is precise
        adGo(best.base)
        local t0 = os.clock()
        local bestD, bestAt = flat(best.base, hullNow.Position), os.clock()
        while os.clock() - t0 < 120 and alive() and keepGoing() and not gone() do
            local d = flat(best.base, hullNow.Position)
            if d < 45 then break end
            if d < bestD - 10 then
                bestD, bestAt = d, os.clock()
            elseif os.clock() - bestAt > 6 then
                res = "stuck"
                break
            end
            if not adActive() and os.clock() - t0 > 2 and not adGo(best.base) then break end
            task.wait(0.1)
        end
        adStop()
    end
    if res ~= "stuck" and not gone() and alive() and keepGoing() then
        res = pickupApproach(best, keepGoing)
    end
    Status.CoinLast = tostring(res) .. (gone() and "+" or "")
    if res == true or gone() then
        Status.CoinMiss, Status.CoinStuck = 0, 0
        local h = getPart("Hull")
        if h then Status.CoinGoodPos = h.Position end
    else
        Status.CoinMiss = (Status.CoinMiss or 0) + 1
    end
    if res == "stuck" then
        Status.CoinStuck = (Status.CoinStuck or 0) + 1
        if Status.CoinStuck >= 2 then
            -- wedged off the road (AutoDrive cannot plan from here): wiggle
            -- free, then drive straight back to the last place a pickup worked
            Status.Coin = "รถติด กำลังถอยกลับถนน"
            for i = 1, 2 do
                local dir = (i % 2 == 0) and -1 or 1
                setIn(0, 1, dir)
                task.wait(1.3)
                setIn(0.8, 0, -dir)
                task.wait(1.2)
            end
            clearIn()
            if Status.CoinGoodPos then
                approach(function() return Status.CoinGoodPos end, 10, 20, nil, false)
            end
            Status.CoinStuck = 0
        end
    end
    if res == "stuck" then
        -- whatever blocked this one blocks its neighbours too
        for uid, e in pairs(spots) do
            if flat(e.base, best.base) < 150 then triedCoin[uid] = os.clock() + 300 end
        end
        Status.Coin = "ทางตัน ข้ามจุดนี้ไป"
    end
end

-- ── 5b. NPC TRAFFIC ───────────────────────────────────────────────────────────
-- Traffic is simulated by RBRCTrafficClient's RenderStepped loop. Its
-- MaxRenderCars upvalue caps how many cars exist around you (0 = none), and
-- nativeHit/resolveHit are the collision solvers against your car.
local Traffic = { fn = nil, maxIdx = nil, maxOrig = nil, hits = {} }

local function findTrafficLoop()
    if Traffic.fn then return Traffic.fn end
    if not getconnections then return nil end
    for _, c in ipairs(getconnections(game:GetService("RunService").RenderStepped)) do
        local f = c.Function
        local ok, scr = pcall(function() return getfenv(f).script end)
        if ok and typeof(scr) == "Instance" and scr.Name == "RBRCTrafficClient" then
            Traffic.fn = f
            local attr = ReplicatedStorage.RBRCTraffic:GetAttribute("MaxRenderCars")
            local maxDefault = (type(attr) == "number" and attr > 0) and attr or 90
            for idx, v in pairs(debug.getupvalues(f)) do
                if type(v) == "function" then
                    local n = debug.info(v, "n")
                    if n == "nativeHit" or n == "resolveHit" then Traffic.hits[idx] = v end
                elseif type(v) == "number" and v == maxDefault and not Traffic.maxIdx then
                    Traffic.maxIdx, Traffic.maxOrig = idx, v
                end
            end
            return f
        end
    end
    return nil
end

local function noHit() return nil end
local function applyTraffic()
    local f = findTrafficLoop()
    if not f then return false end
    if Traffic.maxIdx then
        pcall(debug.setupvalue, f, Traffic.maxIdx, Config.NoTraffic and 0 or Traffic.maxOrig)
    end
    for idx, orig in pairs(Traffic.hits) do
        pcall(debug.setupvalue, f, idx, Config.NoTraffic and noHit or orig)
    end
    return true
end
if Config.NoTraffic then task.defer(applyTraffic) end

-- Trees and lamp poles: KrCollisionBuilder lets the car pass through them when
-- PROP_ALLOW (server verdict) and PROP_HIDE (graphics option) are both on.
-- Both are client-side; the server does not snap the car back.
local Props = { orig = nil, hidden = setmetatable({}, { __mode = "k" }) }
local KCB = (function()
    local ok, m = pcall(require, ReplicatedStorage:WaitForChild("KrCollisionBuilder", 10))
    return (ok and type(m) == "table" and m.setPropHidden) and m or nil
end)()

local function hideTreeVisuals(on)
    local city = workspace:FindFirstChild("KrCity")
    if not city then return end
    for _, tile in ipairs(city:GetChildren()) do
        local trees = tile:FindFirstChild("Trees")
        if trees and (on and not Props.hidden[trees] or not on and Props.hidden[trees]) then
            Props.hidden[trees] = on or nil
            for _, d in ipairs(trees:GetDescendants()) do
                if d:IsA("BasePart") then d.LocalTransparencyModifier = on and 1 or 0 end
            end
        end
    end
end

local function applyProps()
    if not KCB then return false end
    if not Props.orig then
        Props.orig = {
            at = KCB.PROP_ALLOW.trees, ap = KCB.PROP_ALLOW.poles,
            ht = KCB.PROP_HIDE.trees, hp = KCB.PROP_HIDE.poles,
        }
    end
    if Config.NoProps then
        KCB.PROP_ALLOW.trees, KCB.PROP_ALLOW.poles = true, true
        pcall(KCB.setPropHidden, true, true)
    else
        local o = Props.orig
        KCB.PROP_ALLOW.trees, KCB.PROP_ALLOW.poles = o.at, o.ap
        pcall(KCB.setPropHidden, o.ht, o.hp)
    end
    pcall(hideTreeVisuals, Config.NoProps)
    return true
end
task.spawn(function()
    -- the game re-applies its own verdict now and then; keep ours on top
    while alive() do
        if Config.NoProps and KCB and not (KCB.PROP_PASS.trees and KCB.PROP_PASS.poles) then applyProps() end
        if Config.NoProps then pcall(hideTreeVisuals, true) end
        task.wait(3)
    end
end)
onCleanup(function()
    if Config.NoProps and Props.orig then
        Config.NoProps = false
        applyProps()
        Config.NoProps = true
    end
end)
onCleanup(function()
    if Config.NoTraffic then
        Config.NoTraffic = false
        applyTraffic()
        Config.NoTraffic = true
    end
end)

