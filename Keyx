-- ── CONFIG PROFILES ───────────────────────────────────────────────────────────
-- Named snapshots of Config in 2KScript_Raycity/profiles/<name>.json. Unlike the
-- running config.json, a profile also keeps AutoMission/AutoCoin, so an
-- auto-loaded profile can start farming as soon as the hub runs.
local PROFILE_DIR = CFG_DIR .. "/profiles"
local AUTOLOAD_FILE = CFG_DIR .. "/autoload.txt"

local function cleanProfileName(name)
    name = tostring(name or ""):gsub("[/\\:%*%?\"<>|]", ""):gsub("^%s+", ""):gsub("%s+$", "")
    return name ~= "" and name:sub(1, 40) or nil
end

local function profileList()
    local out = {}
    pcall(function()
        if not (listfiles and isfolder and isfolder(PROFILE_DIR)) then return end
        for _, path in ipairs(listfiles(PROFILE_DIR)) do
            local name = tostring(path):match("([^/\\]+)%.json$")
            if name then out[#out + 1] = name end
        end
    end)
    table.sort(out, function(a, b) return a:lower() < b:lower() end)
    return out
end

local function profileSave(name)
    name = cleanProfileName(name)
    if not name then return false, "ตั้งชื่อ config ก่อน" end
    if not writefile then return false, "executor นี้เขียนไฟล์ไม่ได้" end
    local ok, err = pcall(function()
        if makefolder and isfolder then
            if not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
            if not isfolder(PROFILE_DIR) then makefolder(PROFILE_DIR) end
        end
        local out = {}
        for k, v in pairs(Config) do out[k] = v end
        writefile(PROFILE_DIR .. "/" .. name .. ".json", HttpService:JSONEncode(out))
    end)
    return ok, ok and name or tostring(err)
end

local function profileRead(name)
    name = cleanProfileName(name)
    if not (name and isfile and readfile) then return nil end
    local path = PROFILE_DIR .. "/" .. name .. ".json"
    if not isfile(path) then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    return ok and type(data) == "table" and data or nil
end

-- copies matching keys into Config; returns how many were applied
local function profileApply(data)
    local n = 0
    for k, v in pairs(data or {}) do
        if Config[k] ~= nil and type(v) == type(Config[k]) then
            Config[k] = v
            n += 1
        end
    end
    return n
end

local function profileDelete(name)
    name = cleanProfileName(name)
    if not (name and delfile and isfile) then return false end
    local path = PROFILE_DIR .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    return (pcall(delfile, path))
end

local function autoloadGet()
    local ok, v = pcall(function()
        return isfile and readfile and isfile(AUTOLOAD_FILE) and readfile(AUTOLOAD_FILE) or nil
    end)
    return ok and cleanProfileName(v) or nil
end

local function autoloadSet(name)
    pcall(function()
        if not name then
            if delfile and isfile and isfile(AUTOLOAD_FILE) then delfile(AUTOLOAD_FILE) end
            return
        end
        if makefolder and isfolder and not isfolder(CFG_DIR) then makefolder(CFG_DIR) end
        writefile(AUTOLOAD_FILE, name)
    end)
end

do
