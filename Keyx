    adStop()
    clearIn()
end)

local function yawOf(v) return math.atan2(-v.X, -v.Z) end

local function headingError(hull, pos)
    local d = (pos - hull.Position) * Vector3.new(1, 0, 1)
    local err = yawOf(d) - yawOf(hull.CFrame.LookVector)
    err = (err + math.pi) % (2 * math.pi) - math.pi
    return math.deg(err), d.Magnitude
end

-- Steer straight at a point (positive AutoSteer = left). Backs out when the
-- car stops making progress. rolling = leave the car moving afterwards.
-- Returns true when reached, false on timeout, "stuck" when it gave up.
local function approach(getPos, radius, maxT, stopCond, rolling)
    local hull = getPart("Hull")
    if not hull then return false end
    local t0 = os.clock()
    local reached = false
    local slowSince, unstucks = nil, 0
    while os.clock() - t0 < maxT and alive() do
        if stopCond and stopCond() then reached = true break end
        local pos = getPos()
        if not pos or not hull.Parent then break end
        local deg, dist = headingError(hull, pos)
        if dist <= radius then reached = true break end
        local speed = hull.AssemblyLinearVelocity.Magnitude

        if speed < 3 and os.clock() - t0 > 1 then
            slowSince = slowSince or os.clock()
            if os.clock() - slowSince > 1.2 then
                unstucks += 1
                if unstucks > 2 then
                    setIn(0, 1, 0)
                    task.wait(0.3)
                    clearIn()
                    return "stuck"
                end
                -- reverse with the wheel turned the other way, then retry
                setIn(0, 1, -math.clamp(deg / 25, -1, 1))
                task.wait(0.9)
                slowSince = nil
            end
        else
            slowSince = nil
        end

        local thr, brk = 0.7, 0
        local turn = math.abs(deg)
        if turn > 70 then
            thr = 0.3
        elseif turn > 30 then
            thr = 0.5
        end
        -- slow down for tight final turns only
        if dist < 30 and turn > 25 and speed > 25 then thr, brk = 0, 0.4 end
        setIn(thr, brk, math.clamp(deg / 25, -1, 1))
        task.wait(0.03)
    end
    if rolling and reached then
        clearIn()
    else
        setIn(0, 1, 0)
        task.wait(0.4)
        clearIn()
    end
    return reached
end

local function driveNear(pos, radius, stopCond, keepGoing, rolling)
    local hull = getPart("Hull")
    if not hull then return false end
    if flat(pos, hull.Position) > 60 then
        adGo(pos)
        local t0 = os.clock()
        -- progress watchdog: AutoDrive keeps warping at roadblocks forever
        local bestD, bestAt = flat(pos, hull.Position), os.clock()
        while os.clock() - t0 < 150 and alive() and (not keepGoing or keepGoing()) do
            if stopCond and stopCond() then break end
            local d = flat(pos, hull.Position)
            if d < 35 then break end
            if d < bestD - 10 then
                bestD, bestAt = d, os.clock()
            elseif os.clock() - bestAt > 6 then
                adStop()
                clearIn()
                return "stuck"
            end
            if not adActive() then
                -- AutoDrive gave up (arrived short or refused); retry once
                if os.clock() - t0 > 2 and not adGo(pos) then break end
            end
            task.wait(0.1)
        end
        adStop()
    end
    if not alive() or (keepGoing and not keepGoing()) then return false end
    if stopCond and stopCond() then return true end
    local dist = flat(pos, hull.Position)
    return approach(function() return pos end, radius, 3 + dist / 12, stopCond, rolling)
end

-- ── 4b. SPEED: auto boost + faster corners ───────────────────────────────────
-- The car tops out around 155 km/h on its own, so the cruise cap is not the
-- limit. Boost uses the game's own boost() from RCDriveClient (checks and spends
-- SP like the key does). AutoDrive's corner caps (m/s by turn angle) are raised
-- a little; stock values are restored on cleanup or when switched off.
local Speed = { boostFn = nil, stockCaps = nil }
local function findBoostFn()
    if Speed.boostFn ~= nil then return Speed.boostFn or nil end
    Speed.boostFn = false
    for _, f in ipairs(getgc and getgc() or {}) do
        if type(f) == "function" and islclosure and islclosure(f) then
            local ok, src = pcall(debug.info, f, "s")
            if ok and tostring(src):find("RCDriveClient") and debug.info(f, "n") == "boost" then
                Speed.boostFn = f
                break
            end
        end
    end
    return Speed.boostFn or nil
end

local function applyCorners()
    local C = AutoDrive.C
    if not C then return end
    if not Speed.stockCaps then Speed.stockCaps = { C.cap1, C.cap2, C.cap3 } end
    local s = Speed.stockCaps
    if Config.FastCorners then
        C.cap1, C.cap2, C.cap3 = math.max(s[1], 46), math.max(s[2], 24), math.max(s[3], 16)
    else
        C.cap1, C.cap2, C.cap3 = s[1], s[2], s[3]
    end
end
applyCorners()
onCleanup(function()
    local C, s = AutoDrive.C, Speed.stockCaps
    if C and s then C.cap1, C.cap2, C.cap3 = s[1], s[2], s[3] end
end)

task.spawn(function()
    while alive() do
        if Config.AutoBoost and (Config.AutoMission or Config.AutoCoin) and adActive() then
            local D = gshared().RCDrive
            local ph = D and D.phys
            local car = getCar()
            local hull = getPart("Hull")
            if ph and hull and car and not ph.boosting then
                local kmh = hull.AssemblyLinearVelocity.Magnitude / 2 * 3.6
                local dbg = tostring(car:GetAttribute("AutoDriveDebug") or "")
                local cap = tonumber(dbg:match("cap=([%d%.]+)")) or 0
                local okSp, sp = pcall(D.sp)
                sp = okSp and tonumber(sp) or 0
                -- only on fast straight stretches, keeping some SP in reserve
                if kmh > 60 and cap >= 40 and sp >= (tonumber(Config.BoostKeepSP) or 20) then
                    local fn = findBoostFn()
                    if fn then pcall(fn) end
                end
            end
        end
        task.wait(0.25)
    end
end)

